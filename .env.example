# Configure these privately in Hostinger Environment Variables.
ERP_PUBLIC_URL=https://crm.itsss.co.in
# Replace YOUR_USERNAME with the hosting account name. Keep this outside
# public_html, hbuilds, and the application directory; it must be writable.
ERP_DATA_DIR=/home/YOUR_USERNAME/itsss-crm-data
ERP_ADMIN_EMAIL=your-email@example.com
ERP_ADMIN_NAME=Administrator
# Generate locally with: npm run auth:hash
ERP_ADMIN_PASSWORD_HASH=
# For a NEW workspace: npm run vault:key
# For migrated encrypted records: retain the original ERP_VAULT_KEY.
ERP_VAULT_KEY=
ERP_SESSION_HOURS=12
# Optional legacy/bootstrap accounts. New users can be provisioned in
# Settings > Users > Set password; active membership and role are required.
ERP_AUTH_USERS=[]
